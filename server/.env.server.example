# server/.env.server 예시 — 이 파일을 복사해 server/.env.server로 저장하고 값을 채운다(그 파일은 git 제외).
# PostgreSQL 접속 주소(사용자:비밀번호@호스트:포트/DB명)
DATABASE_URL=postgresql+psycopg://<사용자>:<비밀번호>@localhost:5432/report_db
# 세션 쿠키 서명용 비밀값 — 아무 긴 무작위 문자열. 바꾸면 모든 사용자가 다시 로그인해야 한다.
SESSION_SECRET=<긴 무작위 문자열>
# https(Cloudflare Tunnel)로만 쓰면 true. 사무실 LAN에서 http://IP:8000 으로도 쓰려면 false.
SESSION_COOKIE_SECURE=true
# 그룹웨어 자동 로그인(그룹웨어 nginx의 X-Relay-Secret과 같은 값) — 비우면 보고서 자체 로그인 모드
GROUPWARE_RELAY_SECRET=<긴 무작위 문자열>
# 그룹웨어 직원이 처음 들어오면 자동 등록되는 회사(company.id)
GROUPWARE_COMPANY_ID=1

# 고객사 메일 전송(현장 화면 "📧 고객사 전송", server/api/mailer.py) — 회사 네이버 메일 SMTP(smtp.naver.com:465).
# 네이버 메일 환경설정 → POP3/IMAP 설정 → "SMTP 사용" 켜기. 2단계 인증 계정이면 애플리케이션 비밀번호를 넣는다.
MAIL_SMTP_USER=회사아이디@naver.com
MAIL_SMTP_PASSWORD=
# 선택: MAIL_FROM_NAME(기본 한국미래안전), MAIL_CC(기본 = 보내는 주소), MAIL_SMTP_HOST/MAIL_SMTP_PORT

# 담당요원 K2B 비밀번호 잠금 열쇠(server/api/k2b_secret.py) — 처음 한 번 만들어 넣고 절대 바꾸지 않는다(바꾸면 저장된 K2B 비밀번호를 못 풂).
# 만들기: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
K2B_SECRET_KEY=
# 파일 저장소 위치(server/api/storage.py) — 비우면 프로그램 폴더의 data
# DATA_DIR=D:\보고서저장소
