# server/.env.server 예시 — 이 파일을 복사해 server/.env.server로 저장하고 값을 채운다(그 파일은 git 제외).
# PostgreSQL 접속 주소(사용자:비밀번호@호스트:포트/DB명)
DATABASE_URL=postgresql+psycopg://<사용자>:<비밀번호>@localhost:5432/report_db
# 세션 쿠키 서명용 비밀값 — 아무 긴 무작위 문자열. 바꾸면 모든 사용자가 다시 로그인해야 한다.
SESSION_SECRET=<긴 무작위 문자열>
# https(Cloudflare Tunnel)로만 쓰면 true. 사무실 LAN에서 http://IP:8000 으로도 쓰려면 false.
SESSION_COOKIE_SECURE=true
# 그룹웨어 자동 로그인(그룹웨어 nginx의 X-Relay-Secret과 같은 값) — 비우면 보고서 자체 로그인 모드
GROUPWARE_RELAY_SECRET=<긴 무작위 문자열>
# 그룹웨어 직원이 처음 들어오면 자동 등록되는 회사(company.id)
GROUPWARE_COMPANY_ID=1
